# Copy this file to .dev.vars and fill in your own values.
# .dev.vars is gitignored. Never commit real credentials.

# Telegram bot token from @BotFather (required)
BOT_TOKEN=123456789:replace_me

# Random string Telegram echoes in X-Telegram-Bot-Api-Secret-Token (required)
WEBHOOK_SECRET=replace_with_a_random_string

# Base64-encoded 32-byte key for AES-GCM (generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))")
TOKEN_KEY=replace_with_base64_32_byte_key

# AUT CAS credentials (only used by `npm run smoke:login`; the bot asks for them in chat)
AUT_USERNAME=your_student_id
AUT_PASSWORD=your_password
