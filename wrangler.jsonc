// Cloudflare Workers config. Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aut-food-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,

  // The Mini App (public/app.html) is served by this Worker. API routes live under
  // /api/* and the Telegram webhook under /telegram, so they never clash with a
  // static file.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  "vars": {
    // Change this when deploying your own copy (see README).
    "APP_URL": "https://aut-food-bot.matinbodaghi07.workers.dev/app.html"
  },

  // Values live only in Cloudflare (`wrangler secret put NAME`), never in this repo.
  //   BOT_TOKEN       Telegram bot token from @BotFather
  //   WEBHOOK_SECRET  random string Telegram echoes in X-Telegram-Bot-Api-Secret-Token
  //   TOKEN_KEY       base64 32-byte AES key that encrypts the AUT password and session cookie
  "secrets": { "required": ["BOT_TOKEN", "WEBHOOK_SECRET", "TOKEN_KEY"] },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aut-food-bot",
      "database_id": "d9a25a8f-bcd7-4dc9-9464-fb17fd27f8b0",
      "migrations_dir": "migrations"
    }
  ],

  "observability": { "enabled": true }
}
