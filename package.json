{
  "name": "AUT-food-bot",
  "version": "0.1.0",
  "private": true,
  "description": "AUT-food-bot — Telegram bot for the Amirkabir University of Technology food system (food.aut.ac.ir), running on Cloudflare Workers",
  "license": "MIT",
  "author": "Matin Bodaghi (https://github.com/MatinBodaghi)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatinBodaghi/AUT-food-bot.git"
  },
  "bugs": {
    "url": "https://github.com/MatinBodaghi/AUT-food-bot/issues"
  },
  "homepage": "https://github.com/MatinBodaghi/AUT-food-bot#readme",
  "keywords": [
    "telegram-bot",
    "cloudflare-workers",
    "typescript",
    "aut",
    "amirkabir",
    "food",
    "university",
    "persian"
  ],
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "logs": "wrangler tail",
    "types": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply aut-food-bot --remote",
    "db:migrate:local": "wrangler d1 migrations apply aut-food-bot --local",
    "webhook": "node tools/set-webhook.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "smoke:login": "tsx tools/test-client.mjs",
    "inspect": "node tools/inspect.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261029.1",
    "@grammyjs/types": "^5.0.0",
    "playwright-core": "^1.64.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "node-html-parser": "^9.0.5"
  }
}
